# Optional Compose settings. Copy this file to .env before editing.
SUBLINK_IMAGE=ghcr.io/hbsx/sublinkx:latest
# Host port. Keep the container's db/config.yaml port set to 8000.
SUBLINK_PORT=8000
# Parent directory containing db, template and logs.
SUBLINK_DATA_DIR=./data

# Login history: fixed at the most recent 20 events, RAM only.
# Configure Telegram in account settings, or seed it with these variables.
SUBLINK_LOGIN_TG_ENABLED=0
SUBLINK_LOGIN_TG_BOT_TOKEN=
SUBLINK_LOGIN_TG_CHAT_ID=
# Docker's 127.0.0.1 is the container itself; the proxy must accept container connections.
SUBLINK_LOGIN_TG_PROXY_URL=
# Trust only the actual immediate reverse proxy/connector IP or narrow CIDR.
# Leave empty for direct access. Do not trust the entire LAN or 0.0.0.0/0.
SUBLINK_LOGIN_TRUSTED_PROXIES=
SUBLINK_LOGIN_IP_HEADER=CF-Connecting-IP
# off / console / file. Login audit records never go to files in any mode.
SUBLINK_LOG_MODE=off
